{
  "name": "github-pr-ai-reviewer",
  "version": "2.0.0",
  "description": "Chrome extension for AI-powered GitHub Pull Request reviews using OpenRouter",
  "scripts": {
    "build:extension": "echo 'Extension is ready to load - no build needed'",
    "lint": "eslint extension/scripts/**/*.js extension/popup/*.js",
    "lint:fix": "eslint --fix extension/scripts/**/*.js extension/popup/*.js",
    "format": "prettier --write \"extension/**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"extension/**/*.{js,json,css,html}\"",
    "validate": "npm run lint && npm run format:check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "zip": "npm run validate && cd extension && zip -r ../extension.zip . -x '*.DS_Store' && cd ..",
    "clean": "rm -f extension.zip"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "extension/scripts/**/*.js",
      "extension/popup/**/*.js",
      "!extension/scripts/background.js",
      "!extension/scripts/content.js",
      "!extension/popup/popup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:viktor-svirsky/gitHub-pr-ai-reviewer.git"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "ai",
    "chrome-extension",
    "openrouter",
    "llm"
  ],
  "author": "",
  "license": "MIT"
}
